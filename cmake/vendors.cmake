# Prefer supplied or installed packages; download a matching prebuilt as a fallback.
include(FetchContent)
set(PP_BUILD_VENDOR_PREBUILT_URL "" CACHE STRING "Root URL containing prebuilt vendor archives")
set(PP_BUILD_APPLE_PREBUILTS "" CACHE PATH "Directory containing Apple vendor XCFrameworks")

function(partout_vendor_source vendor output_dir)
    if(APPLE AND PP_BUILD_APPLE_PREBUILTS)
        set(${output_dir} "${PP_BUILD_APPLE_PREBUILTS}/${vendor}.xcframework" PARENT_SCOPE)
        return()
    endif()
    if(NOT PP_BUILD_VENDOR_PREBUILT_URL)
        message(FATAL_ERROR
            "No ${vendor} package found. Supply its package directory or CMAKE_PREFIX_PATH, "
            "or set PP_BUILD_VENDOR_PREBUILT_URL for automatic downloads.")
    endif()

    if(ANDROID)
        if(NOT CMAKE_ANDROID_ARCH_ABI STREQUAL "arm64-v8a")
            message(FATAL_ERROR "Prebuilt vendors only support Android arm64-v8a")
        endif()
        set(target android-arm64-v8a)
    elseif(APPLE)
        set(target apple-xcframework)
    elseif(WIN32 OR CMAKE_SYSTEM_NAME STREQUAL "Linux")
        if(ARCH_NAME MATCHES "^(arm64|aarch64)$")
            set(arch arm64)
        elseif(ARCH_NAME MATCHES "^(amd64|x86_64|x64)$")
            set(arch x64)
        else()
            message(FATAL_ERROR "No prebuilt vendors for architecture '${ARCH_NAME}'")
        endif()
        set(target "${PLATFORM_NAME}-${arch}")
    else()
        message(FATAL_ERROR "No prebuilt vendors for ${CMAKE_SYSTEM_NAME}")
    endif()
    if(APPLE)
        set(archive "${vendor}.xcframework.zip")
    elseif(WIN32)
        set(archive "${vendor}-${target}.zip")
    else()
        set(archive "${vendor}-${target}.tar.gz")
    endif()
    string(REGEX REPLACE "/+$" "" vendor_root "${PP_BUILD_VENDOR_PREBUILT_URL}")
    string(TOUPPER "${vendor}" vendor_id)
    set(hash_var "PP_BUILD_${vendor_id}_PREBUILT_HASH")
    string(REPLACE "-" "_" content_name "partout_${vendor}_${target}_prebuilt")
    set(fetch_args URL "${vendor_root}/${archive}"
        SOURCE_SUBDIR "__partout_no_cmake_subdir" DOWNLOAD_EXTRACT_TIMESTAMP FALSE)
    if(DEFINED ${hash_var} AND NOT "${${hash_var}}" STREQUAL "")
        list(APPEND fetch_args URL_HASH "${${hash_var}}")
    endif()
    FetchContent_Declare(${content_name} ${fetch_args})
    FetchContent_MakeAvailable(${content_name})
    FetchContent_GetProperties(${content_name} SOURCE_DIR source_dir)
    set(${output_dir} "${source_dir}" PARENT_SCOPE)
endfunction()

# Existing Apple archives bundle each vendor into one library, without a package config.
function(partout_import_apple_vendor vendor source_dir)
    if(NOT EXISTS "${source_dir}/Info.plist")
        file(GLOB frameworks LIST_DIRECTORIES TRUE "${source_dir}/*.xcframework")
        list(LENGTH frameworks count)
        if(NOT count EQUAL 1)
            message(FATAL_ERROR "Expected one XCFramework in ${source_dir}")
        endif()
        list(GET frameworks 0 source_dir)
    endif()
    if(CMAKE_SYSTEM_NAME MATCHES "^(iOS|tvOS)$")
        string(TOLOWER "${CMAKE_SYSTEM_NAME}" os)
        set(slice "${os}-arm64")
        if(CMAKE_OSX_SYSROOT MATCHES "[Ss]imulator")
            set(slice "${os}-arm64_x86_64-simulator")
        endif()
    else()
        set(slice macos-arm64_x86_64)
    endif()
    set(slice_dir "${source_dir}/${slice}")
    if(NOT EXISTS "${slice_dir}/lib${vendor}.a")
        message(FATAL_ERROR "Missing ${vendor} archive in ${slice_dir}")
    endif()
    if(vendor STREQUAL "openssl")
        set(target OpenSSL::Crypto)
    else()
        set(target MbedTLS::mbedtls)
    endif()
    add_library(${target} STATIC IMPORTED GLOBAL)
    set_target_properties(${target} PROPERTIES
        IMPORTED_LOCATION "${slice_dir}/lib${vendor}.a"
        INTERFACE_INCLUDE_DIRECTORIES "${slice_dir}/Headers")
    if(vendor STREQUAL "openssl")
        add_library(OpenSSL::SSL INTERFACE IMPORTED GLOBAL)
        target_link_libraries(OpenSSL::SSL INTERFACE OpenSSL::Crypto)
    endif()
endfunction()

function(partout_find_vendor package vendor target)
    set(bundle_vendor OFF PARENT_SCOPE)
    if(TARGET ${target})
        return()
    endif()
    if(package STREQUAL "OpenSSL")
        set(version 3)
    endif()
    if(NOT (APPLE AND PP_BUILD_APPLE_PREBUILTS))
        # Never discover host packages implicitly while cross-compiling.
        if(CMAKE_CROSSCOMPILING)
            set(search_options NO_CMAKE_SYSTEM_PATH NO_SYSTEM_ENVIRONMENT_PATH
                NO_CMAKE_PACKAGE_REGISTRY NO_CMAKE_SYSTEM_PACKAGE_REGISTRY)
        elseif(APPLE)
            find_program(HOMEBREW_EXECUTABLE brew)
            if(HOMEBREW_EXECUTABLE)
                set(formula "${vendor}")
                if(vendor STREQUAL "openssl")
                    set(formula openssl@3.5)
                endif()
                execute_process(COMMAND "${HOMEBREW_EXECUTABLE}" --prefix "${formula}"
                    OUTPUT_VARIABLE prefix OUTPUT_STRIP_TRAILING_WHITESPACE
                    RESULT_VARIABLE result ERROR_QUIET)
                if(result EQUAL 0)
                    list(APPEND CMAKE_PREFIX_PATH "${prefix}")
                endif()
            endif()
        endif()
        find_package(${package} ${version} QUIET CONFIG GLOBAL ${search_options})
        # Many system OpenSSL installations expose only CMake's FindOpenSSL module.
        if(NOT TARGET ${target} AND package STREQUAL "OpenSSL" AND NOT CMAKE_CROSSCOMPILING)
            find_package(OpenSSL 3 QUIET MODULE GLOBAL)
        endif()
    endif()
    if(TARGET ${target})
        # Package directories are cached by find_package, including our downloads.
        cmake_path(IS_PREFIX FETCHCONTENT_BASE_DIR "${${package}_DIR}" NORMALIZE downloaded)
        if(downloaded OR (PARTOUT_${vendor}_DOWNLOADED_DIR AND
           "${${package}_DIR}" STREQUAL "${PARTOUT_${vendor}_DOWNLOADED_DIR}"))
            set(bundle_vendor ON PARENT_SCOPE)
        endif()
        return()
    endif()
    partout_vendor_source("${vendor}" source_dir)
    if(APPLE)
        partout_import_apple_vendor("${vendor}" "${source_dir}")
    else()
        find_package(${package} ${version} REQUIRED CONFIG GLOBAL
            PATHS "${source_dir}/lib/cmake/${package}" NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH)
        set(PARTOUT_${vendor}_DOWNLOADED_DIR "${${package}_DIR}" CACHE INTERNAL
            "Package directory supplied by Partout's download fallback" FORCE)
        set(bundle_vendor ON PARENT_SCOPE)
    endif()
endfunction()

foreach(vendor openssl mbedtls)
    string(TOUPPER "${vendor}" vendor_id)
    if(NOT PP_BUILD_USE_${vendor_id})
        continue()
    endif()
    if(vendor STREQUAL "openssl")
        partout_find_vendor(OpenSSL openssl OpenSSL::SSL)
        set(target OpenSSL::Crypto)
        set(libraries OpenSSL::SSL OpenSSL::Crypto)
    else()
        partout_find_vendor(MbedTLS mbedtls MbedTLS::mbedtls)
        set(target MbedTLS::mbedtls)
        set(libraries MbedTLS::mbedtls)
        foreach(dependency MbedTLS::mbedx509 MbedTLS::mbedcrypto MbedTLS::tfpsacrypto)
            if(TARGET ${dependency})
                list(APPEND libraries ${dependency})
            endif()
        endforeach()
    endif()
    # Zig consumes headers; CMake links the package targets.
    get_target_property(include_dirs ${target} INTERFACE_INCLUDE_DIRECTORIES)
    unset(include_dir)
    find_path(include_dir NAMES "${vendor}/ssl.h" PATHS ${include_dirs}
        NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH NO_CACHE REQUIRED)
    set(PARTOUT_${vendor_id}_INCLUDE_DIR "${include_dir}")
    list(APPEND PARTOUT_CORE_LIBRARIES ${libraries})
    foreach(library IN LISTS libraries)
        get_target_property(type ${library} TYPE)
        if(bundle_vendor AND type STREQUAL "SHARED_LIBRARY")
            list(APPEND PARTOUT_RUNTIME_LIBRARIES ${library})
        endif()
    endforeach()
endforeach()

if(PP_BUILD_USE_OPENSSL AND CMAKE_LIBRARY_ARCHITECTURE AND
   EXISTS "/usr/include/${CMAKE_LIBRARY_ARCHITECTURE}/openssl/opensslconf.h")
    set(PARTOUT_OPENSSL_CONFIG_INCLUDE_DIR "/usr/include/${CMAKE_LIBRARY_ARCHITECTURE}")
endif()
if(PP_BUILD_USE_WIREGUARD)
    include("${CMAKE_CURRENT_LIST_DIR}/wg-go.cmake")
    list(APPEND PARTOUT_CORE_LIBRARIES Partout::WireGuard)
endif()
